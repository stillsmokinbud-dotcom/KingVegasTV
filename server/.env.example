# Copy to .env (or set these in your hosting dashboard)
APP_NAME=King Vegas TV
PUBLIC_URL=https://your-domain.com
PORT=8080
# Your administrator account (always Premium, can give Premium to anyone at /admin)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
DEVICE_LIMIT=10
# Leave empty for TEST MODE (simulated payments). Get these from dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DATA_DIR=./data
